{
   "id": "qwen3_asr_subtitles",
   "description": "Generate transcript, word timestamps, and SRT subtitles from speech using Qwen3 ASR with model-side audio chunking.",
   "inputs": {
      "source_audio": "${workflow_dir}/../test.wav",
      "language": "ja",
      "vad_model": "${workflow_dir}/silero_vad_16k.safetensors",
      "qwen3_asr_model": "${workflow_dir}/qwen3-asr-1.7b-q8_0.gguf",
      "qwen3_forced_aligner_model": "${workflow_dir}/qwen3-forced-aligner-0.6b-q8_0.gguf"
   },
   "steps": [
      {
         "id": "transcribe",
         "type": "model",
         "family": "qwen3_asr",
         "model": "${qwen3_asr_model}",
         "task": "asr",
         "mode": "offline",
         "backend": "vulkan",
         "text_out": "${out_dir}/transcript.txt",
         "words_out": "${out_dir}/words.json",
         "session_options": {
            "qwen3_asr.vad_model_path": "${vad_model}",
            "qwen3_asr.forced_aligner_model_path": "${qwen3_forced_aligner_model}"
         },
         "request": {
            "id": "transcribe",
            "audio": "${source_audio}",
            "language": "${language}",
            "text": "Transcribe the speech exactly.",
            "audio_chunk_mode": "vad",
            "options": {
               "return_timestamps": true,
               "clamp_timestamps_to_audio": true,
               "preserve_punctuation": true
            }
         }
      }
   ]
}
